NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/credit_scoring
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
# Use http://ml-service:8000 inside docker-compose
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_KEY=change-me-internal-key
ML_TIMEOUT_MS=10000
CLIENT_ORIGIN=http://localhost:5173
FAIRNESS_AUDIT_CRON=0 2 * * *
FAIRNESS_AUDIT_WINDOW_DAYS=90
ENABLE_SCHEDULER=true
